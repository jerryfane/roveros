[Unit]
Description=RoverOS screen: HerdrUp full-screen
After=systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
User=rover
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
EnvironmentFile=/etc/rover/kiosk.env
ExecStart=/usr/bin/cage -s -- /usr/lib/rover/kiosk
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
