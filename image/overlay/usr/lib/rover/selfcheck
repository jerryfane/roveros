#!/bin/sh
# Prints one line about the system's state, for boot tests and the serial
# console. Waits up to two minutes for HerdrUp to start.
i=0
while [ $i -lt 120 ] && ! pgrep -x herdrup >/dev/null; do
  sleep 1
  i=$((i + 1))
done

yes_no() { if "$@" >/dev/null 2>&1; then echo yes; else echo no; fi; }
root_ro=$(yes_no sh -c 'findmnt -no OPTIONS / | tr , "\n" | grep -qx ro')
data=$(yes_no findmnt -n /data)
herdrup=$(yes_no pgrep -x herdrup)
# The running machine ID must be the one kept on the data partition.
machine_id=$(yes_no sh -c 'grep -qE "^[0-9a-f]{32}$" /data/machine-id && cmp -s /etc/machine-id /data/machine-id')
state() { systemctl is-active "$1" 2>/dev/null || true; }

# Network over the USB cable: the gadget's address, and (only when the host
# side is the kernel's emulated dummy_hcd, as in the VM) whether SSH answers on
# it from a separate network namespace standing in for the computer. A real
# USB network adapter is never touched: its device path is not under dummy_hcd.
usb_net=$(yes_no sh -c 'ip -4 -o address show | grep -q " inet 172\.16\.42\.1/24 "')
usb_ssh=na
for i in /sys/class/net/*; do
  [ "$(basename "$(readlink -f "$i/device/driver")")" = cdc_ncm ] || continue
  case "$(readlink -f "$i/device")" in */dummy_hcd.*) ;; *) continue ;; esac
  ip netns add rover-host 2>/dev/null
  ip link set "${i##*/}" netns rover-host &&
    ip -n rover-host address add 172.16.42.2/24 dev "${i##*/}" &&
    ip -n rover-host link set "${i##*/}" up && sleep 2
  usb_ssh=$(yes_no ip netns exec rover-host timeout 10 bash -c 'read -r l </dev/tcp/172.16.42.1/22 && [ "${l#SSH-}" != "$l" ]')
  break
done

echo "ROVER-SELFCHECK root_ro=$root_ro data=$data machine_id=$machine_id herdrup=$herdrup" \
  "kiosk=$(state rover-kiosk) ssh=$(state ssh) tailscaled=$(state tailscaled)" \
  "nftables=$(state nftables) network=$(state NetworkManager)" \
  "usb_net=$usb_net usb_ssh=$usb_ssh"

# Explain failures on the console, where the boot test can see them.
for unit in $(systemctl list-units --failed --plain --no-legend | awk '{print $1}'); do
  echo "ROVER-FAILED $unit"
  systemctl status --no-pager --lines=15 "$unit" | sed 's/^/  /'
done

# What HerdrUp printed while drawing its first screen, then the marker the
# boot test waits for before its first screenshot. Again 3 minutes after
# HerdrUp started, for slow first paints (WebKit under emulation).
# PAMName=login moves the kiosk into the rover user's session scope, so its
# own output is not under the service unit: match the service's identifier
# (SyslogIdentifier=%N, the unit's name), the unit's own lines, and systemd's
# messages about the unit (what journalctl -u adds).
kiosk=rover-kiosk
kiosk_log() {
  journalctl -b --no-pager -o cat "$@" \
    _SYSTEMD_UNIT=$kiosk.service + SYSLOG_IDENTIFIER=$kiosk + \
    _PID=1 UNIT=$kiosk.service
}
sleep 20
kiosk_log -n 40 | sed 's/^/ROVER-KIOSK /'
echo "ROVER-SELFCHECK-END"
sleep 160
kiosk_log -n 60 | sed 's/^/ROVER-KIOSK-3MIN /'
# Every page error HerdrUp reported, however many lines came after it.
kiosk_log --grep 'page error' | sed 's/^/ROVER-PAGE-ERROR /'
# Whether the kiosk's stderr reaches the journal at all, independent of how
# many lines the excerpts above keep: its exact start line, under its tag.
if journalctl -b --no-pager -o cat SYSLOG_IDENTIFIER=$kiosk | grep -qx 'ROVER-KIOSK-START'; then
  echo "ROVER-KIOSK-STDERR yes"
else
  echo "ROVER-KIOSK-STDERR no"
fi
# Only an installed package's version counts; a removed one can keep a record.
# One architecture's record: the package is Multi-Arch: same.
webkit=$(dpkg-query -W -f '${db:Status-Status} ${Version}' \
  "libwebkit2gtk-4.1-0:$(dpkg --print-architecture)" 2>&1)
case "$webkit" in
  "installed "?*) echo "ROVER-WEBKIT ${webkit#installed }" ;;
  *) echo "ROVER-WEBKIT unavailable: $webkit" ;;
esac
# What cage itself has composited, out on the console as base64. The boot test
# takes the display's frame on the marker, before grim runs (grim makes cage
# repaint); if the two differ, the compositor stopped presenting frames
# (gitmoot thread 537809).
echo "ROVER-SCREEN-NOW"
sleep 15
runuser -u rover -- env WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=/run/user/1000 \
  grim /tmp/rover-screen.png 2>&1 | sed 's/^/ROVER-GRIM-ERR /'
if [ -s /tmp/rover-screen.png ]; then
  echo "ROVER-GRIM-BEGIN"
  base64 -w 120 /tmp/rover-screen.png | sed 's/^/ROVER-GRIM /'
  echo "ROVER-GRIM-END"
fi
echo "ROVER-SELFCHECK-LATE"
