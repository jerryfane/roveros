#!/bin/sh
# Mounts the data partition before systemd starts, and gives the device a
# machine ID kept there: the root is read-only, and systemd reads
# /etc/machine-id before it mounts anything itself. The first boot creates the
# ID; later boots reuse it.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac

. /scripts/functions

dev=/dev/disk/by-label/rover-data
i=0
while [ ! -e "$dev" ] && [ $i -lt 30 ]; do
  sleep 1
  i=$((i + 1))
done
[ -e "$dev" ] || panic "RoverOS: data partition not found"

/sbin/e2fsck -p "$dev" >/dev/null 2>&1
rc=$?
[ $rc -lt 4 ] || log_warning_msg "RoverOS: e2fsck on the data partition exited $rc"
/bin/rover-mount -t ext4 -o rw,noatime,nosuid,nodev "$dev" "${rootmnt}/data" ||
  panic "RoverOS: cannot mount the data partition"

id="${rootmnt}/data/machine-id"
current=$(cat "$id" 2>/dev/null)
# Keep a valid ID (32 lowercase hex digits); replace anything else.
case "$current" in
  "" | *[!0-9a-f]*) valid=no ;;
  *) if [ ${#current} -eq 32 ]; then valid=yes; else valid=no; fi ;;
esac
if [ $valid = no ]; then
  /bin/tr -d '-' </proc/sys/kernel/random/uuid >"$id.new" && mv "$id.new" "$id"
fi
/bin/rover-mount --bind "$id" "${rootmnt}/etc/machine-id" ||
  log_warning_msg "RoverOS: cannot bind the machine ID"
