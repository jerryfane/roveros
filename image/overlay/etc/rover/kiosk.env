# Environment of HerdrUp on the Rover's screen. Phone builds set their own.
# Output scale set by /usr/lib/rover/kiosk; the build writes the target's.
# The VM screen is 720x1560; scale 2 lays HerdrUp out at 360 logical px.
ROVER_SCALE=2
# Herdrup Desktop's kiosk mode: no window decorations or minimum size, and no
# update notices (RoverOS updates the image). Ignored by versions without it.
HERDRUP_KIOSK=1
